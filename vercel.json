{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/impressum", "destination": "/", "permanent": false },
    { "source": "/impressum.html", "destination": "/", "permanent": false },
    { "source": "/Impressum", "destination": "/", "permanent": false },
    { "source": "/data/:path*", "destination": "/", "permanent": false },
    { "source": "/config/:path*", "destination": "/", "permanent": false },
    { "source": "/scoring/:path*", "destination": "/", "permanent": false },
    { "source": "/scripts/:path*", "destination": "/", "permanent": false },
    { "source": "/ticker/:path*", "destination": "/", "permanent": false },
    { "source": "/aktie/:path*", "destination": "/", "permanent": false },
    {
      "source": "/:file(PLTR|pltr|OSS|oss|AMZN|amzn|TSLA|tsla|HIMS|hims|LMND|lmnd|IBRX|ibrx|MU|mu|IREN|iren|GRAB|grab|SIVE|sive|SPCX|spcx|PYPL|pypl)",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
